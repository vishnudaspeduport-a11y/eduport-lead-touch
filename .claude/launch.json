{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "api/node_modules/wrangler/bin/wrangler.js",
        "dev",
        "--remote",
        "-c",
        "api/wrangler.toml",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/mock/dev.mjs"
      ],
      "port": 5173
    }
  ]
}
