{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "api/node_modules/wrangler/bin/wrangler.js",
        "dev",
        "--remote",
        "-c",
        "api/wrangler.toml",
        "--port",
        "8787",
        "--var",
        "CACHE_SCOPE:dev"
      ],
      "port": 8787
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/mock/dev.mjs"
      ],
      "port": 5173
    },
    {
      "name": "web-local-api-8788",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PROXY=http://127.0.0.1:8788&& npm run dev:local --prefix web"
      ],
      "port": 5173
    },
    {
      "name": "api-noauth",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "api/node_modules/wrangler/bin/wrangler.js",
        "dev",
        "--remote",
        "-c",
        "api/wrangler.toml",
        "--port",
        "8789",
        "--var",
        "CACHE_SCOPE:dev",
        "--var",
        "AUTH_MODE:none",
        "--var",
        "PUBLIC_ROLE:admin"
      ],
      "port": 8789
    },
    {
      "name": "web-local-api-8789",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PROXY=http://127.0.0.1:8789&& npm run dev:local --prefix web"
      ],
      "port": 5173
    }
  ]
}
