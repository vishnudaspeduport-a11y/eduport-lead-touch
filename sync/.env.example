# --- Salesforce connected app (OAuth 2.0 client-credentials flow) ---
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# --- TARGET: Supabase Postgres, role lt_analytics_owner (Session pooler string, port 5432) ---
DATABASE_URL=postgres://lt_analytics_owner.PROJECT_REF:CHANGE_ME_owner@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- SOURCE: Eduport production Postgres (read-only user is enough; only home_customuser/home_payment are read) ---
SOURCE_DATABASE_URL=postgres://eduport_ro:PASSWORD@PROD_HOST:5432/PROD_DB?sslmode=require

# --- Optional ---
LEAD_SINCE=2025-04-01T00:00:00Z     # initial Lead_Master__c / IC lower bound (keeps Supabase storage small; unset = all 1.4M leads)
TASK_SINCE=2026-01-01T00:00:00Z
REFRESH_AFTER_SYNC=1
# SYNC_OBJECTS=Lead_Master__c,Lead_Touch__c,home_payment
